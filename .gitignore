tmp/

# prototype-arti: ignore temporary build artifacts under target/, but keep the
# final release executable so it can be committed/shared.
/prototype-arti/target/*
!/prototype-arti/target/release/
/prototype-arti/target/release/*
!/prototype-arti/target/release/arti-p2p-prototype
/prototype-arti/Cargo.lock

# prototype-apk: Android + Rust build outputs
/prototype-apk/.gradle/
/prototype-apk/build/
/prototype-apk/app/build/
/prototype-apk/app/.cxx/
/prototype-apk/local.properties
/prototype-apk/rust/target/
/prototype-apk/rust/Cargo.lock
# Generated by the cargo-ndk step, not source
/prototype-apk/app/src/main/jniLibs/
# Gradle wrapper jar is generated locally (see README)
/prototype-apk/gradle/wrapper/gradle-wrapper.jar
worktrees/
