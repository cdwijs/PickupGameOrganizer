        <mxCell id="iFYXr7AiiDtmb5_lYsCt-17" connectable="0" parent="iFYXr7AiiDtmb5_lYsCt-16" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="group_public[]" vertex="1">
