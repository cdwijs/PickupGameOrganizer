        <mxCell id="iFYXr7AiiDtmb5_lYsCt-19" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="Group Admin" vertex="1">
          <mxGeometry height="60" width="30" x="680" y="1970" as="geometry" />
        </mxCell>
        <mxCell id="iFYXr7AiiDtmb5_lYsCt-20" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" value="&lt;div&gt;Public&lt;/div&gt;Schedule&lt;div&gt;&amp;nbsp;DB&lt;/div&gt;" vertex="1">
          <mxGeometry height="80" width="60" x="840" y="2100" as="geometry" />
        </mxCell>
        <mxCell id="iFYXr7AiiDtmb5_lYsCt-21" edge="1" parent="1" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="iFYXr7AiiDtmb5_lYsCt-4" value="">
          <mxGeometry height="50" relative="1" width="50" as="geometry">
            <mxPoint x="870" y="2100" as="sourcePoint" />
            <mxPoint x="900" y="1950" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iFYXr7AiiDtmb5_lYsCt-22" connectable="0" parent="iFYXr7AiiDtmb5_lYsCt-21" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];" value="Schedule_public[]" vertex="1">
          <mxGeometry relative="1" x="0.3117" y="-1" as="geometry">
            <mxPoint x="-1" y="16" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="iFYXr7AiiDtmb5_lYsCt-23" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="New schedule:&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Only a group admin can create a new schedule&lt;/div&gt;&lt;div&gt;So the new verison of schedule[] has to be signed with the group admin private key.&lt;/div&gt;&lt;div&gt;The admin of the group creates a new schedule struct, and puts it in the array.&lt;/div&gt;&lt;div&gt;The admin of the group removes Schedule structs that are too old from the array.&lt;/div&gt;&lt;div&gt;The group admin signs the new version of the schedules array with his private key.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The scedules[] array changes, the group_public[] does not need to change -&amp;gt; so group_publick needs to contain a pointer to the schedules, not the schedules array itsef.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;A node receives the new version of the schedule array. When the signature is valid, remove older versions and store/forward the new version.&lt;/div&gt;&lt;div&gt;The public key of the group admin for the schedules is in the group_public struct&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="410" x="1720" y="1750" as="geometry" />
        </mxCell>
        <mxCell id="iFYXr7AiiDtmb5_lYsCt-24" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="New member in the group.&lt;div&gt;Needs to be anble to decrypt the group_private and schedule_private parts&lt;/div&gt;&lt;div&gt;But that decryption key needs to be revocable.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Also needs to be able to sign the message &quot;I&#39;m joining or I&#39;m no longer joining&quot;, so ony the member itself can change if he joins or not.&lt;/div&gt;&lt;div&gt;(admins can of course also kick somebody off the list, but that happens by their admin private keys&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The new member must be able to leave. so that will be sending a goodby message signed by their private key. So the group needs to have the bublic keys of the members&lt;/div&gt;&lt;div&gt;After sending the goodby message, the user can forget the credentials and private storage of that group.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="410" x="1720" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="scyU-rpXhNZHvIsvX6Rq-4" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="Group_private_key&lt;div&gt;(Held by group_admins)&lt;/div&gt;" vertex="1">
          <mxGeometry height="30" width="60" x="300" y="-450" as="geometry" />
        </mxCell>
        <mxCell id="scyU-rpXhNZHvIsvX6Rq-5" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=30;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" value="List" vertex="1">
